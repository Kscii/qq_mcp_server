[Unit]
Description=qq_mcp_server confirmed single-account NapCat switch
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/qq_mcp_server
ExecStart=/usr/local/libexec/qq-mcp-server-switch-napcat-account
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qq_mcp_server /var/lib/qq_mcp_server/control /var/lib/qq_mcp_server/napcat /var/lib/qq-mcp-account-switch
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
