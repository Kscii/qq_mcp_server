# 非秘密配置
QQ_ACCOUNT_ID=123456789
QQ_GROUP_ID=987654321
QQ_GROUP_NAME=示例群
HOST_UID=1001
HOST_GID=1002
DATA_DIR=/var/lib/qq_mcp_server
DATABASE_PATH=/data/messages.sqlite3
EXPORT_PATH=/data/groups/987654321.txt
OAUTH_STORAGE_DIR=/data/oauth

# 必需秘密：使用 `openssl rand -base64 32` 分别生成，不要提交。
ONEBOT_ACCESS_TOKEN=

# 配置域名后再增加以下内容并启用 public profile。
